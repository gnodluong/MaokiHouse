{
  "name": "maoki-house",
  "homepage": "https://luongquocdong.github.io/MaokiHouse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx watch api/_lib/server.ts",
    "set-admin": "tsx scripts/setAdminClaim.ts",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "test": "npm run test:db && npm run test:deployment && npm run test:ai",
    "test:db": "node scripts/test-workspace-db.mjs",
    "test:browser": "node scripts/test-workspace-browser.mjs",
    "test:supabase-browser": "node scripts/test-supabase-browser.mjs",
    "supabase:plan": "node scripts/supabase-project.mjs plan",
    "supabase:status": "node --use-env-proxy scripts/supabase-project.mjs status",
    "supabase:apply": "node --use-env-proxy scripts/supabase-project.mjs apply",
    "test:deployment": "node scripts/test-supabase-deployment.mjs",
    "server:ai": "node --use-env-proxy --import tsx --watch api/_lib/assistantServer.ts",
    "test:ai": "tsx scripts/test-assistant.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@popperjs/core": "^2.11.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-bootstrap": "^1.0.1",
    "@types/react-router-dom": "^5.3.3",
    "bootstrap": "^5.3.7",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "flatpickr": "^4.6.13",
    "framer-motion": "^10.18.0",
    "gh-pages": "^6.3.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-big-calendar": "^1.20.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.1",
    "react-scroll": "^1.9.3",
    "recharts": "^3.10.1",
    "tom-select": "^2.6.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vercel/node": "^3.2.24",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "playwright": "1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
