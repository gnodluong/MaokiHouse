# Primary browser backend. Use a publishable key, never a secret/service-role key.
VITE_SUPABASE_URL=https://msucrkkxuplgijxanzxu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# VITE_LOCAL_DEMO is enabled only by the prepared cloud demo profile.
# Legacy API / isolated development demo only. Not needed by the primary workspace.
# Frontend (Vite) — leave unset locally to auto-use http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Backend (server/) — used by `npm run server:dev` and by Vercel in production
FIREBASE_PROJECT_ID=maokihouse
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@maokihouse.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://maokihouse-default-rtdb.asia-southeast1.firebasedatabase.app

CLOUDINARY_CLOUD_NAME=dlkejgkqk
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google AI Studio (aistudio.google.com/apikey) — free tier. Used by the
# Supabase assistant endpoint /api/assistant. Never prefix the key with VITE_.
# Locally, run npm run server:ai alongside npm run dev.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

PORT=5000
CORS_ORIGIN=http://localhost:5173
